DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5544
POSTGRES_DB=clavium
POSTGRES_USER=clavium

# Email verification: off (default) | optional | required.
# Before switching to "required", run:
#   manage.py email_verification --mark-existing
# so accounts that already exist are not asked to verify.
CLAVIUM_EMAIL_VERIFICATION=off
CLAVIUM_PUBLIC_URL=https://clavium-api.example.com
# Outgoing mail (SMTP). Without EMAIL_HOST, emails are only printed to the log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Clavium <no-reply@example.com>
