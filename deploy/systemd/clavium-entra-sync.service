[Unit]
Description=Clavium Microsoft 365 directory sync
After=network-online.target clavium-control.service

[Service]
Type=oneshot
User=enrico
WorkingDirectory=/home/enrico/clavium/control-plane
EnvironmentFile=/home/enrico/clavium/control-plane/.env
ExecStart=/home/enrico/clavium/control-plane/.venv/bin/python manage.py entra_sync
TimeoutStartSec=900
